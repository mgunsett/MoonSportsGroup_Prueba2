# Firebase — el mismo proyecto que usan panel_resultados y las landings
# individuales. Copiá los valores desde el .env del panel (o desde la
# consola de Firebase → Configuración del proyecto → Tus apps).
#
# Sólo se usa para LEER la agenda de partidos (players/{slug}/matches),
# que tiene lectura pública. Sin estas variables el sitio funciona igual
# y la sección "Partidos de la semana" no se muestra.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
